# ==============================================================================
# Webloom (Linked) — Environment Configuration Template
# Duplicate this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Webloom Creator Platform"
NEXT_PUBLIC_DEFAULT_HANDLE="ayaan"

# ------------------------------------------------------------------------------
# 2. Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Publishable Key (Client-side / Browser safe)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Secret Key (Server-side / Elevated admin privileges, bypasses RLS)
SUPABASE_SECRET_KEY="sb_secret_..."

# Direct PostgreSQL connection string (useful for migrations and seed scripts)
# For local Docker Supabase:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54522/postgres"

# ------------------------------------------------------------------------------
# 3. AI Architecture Providers (Mandatory Dual-Stack)
# ------------------------------------------------------------------------------
# Groq API Key: Used for primary LLM inference (Llama 3.3 70B & Llama 3.1 8B)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Google Gemini API Key: Used strictly for 768-dim vector embeddings (`text-embedding-004`)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Payments & Commerce (Digital Storefront & Bookings)
# ------------------------------------------------------------------------------
# Stripe (Global payments)
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (India & international regional availability)
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. Email Communications & CRM Lead Notifications
# ------------------------------------------------------------------------------
# Resend (Transactional emails and subscriber updates)
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Webloom <hello@webloom.me>"

