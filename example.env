# ------------------------------------------------------------------------------
# 3. AI Architecture Providers (Mandatory Dual-Stack)
# ------------------------------------------------------------------------------
# Groq API Key: Used for primary LLM inference (Llama 3.3 70B & Llama 3.1 8B)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Google Gemini API Key: Used strictly for 768-dim vector embeddings (`text-embedding-004`)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Payments & Commerce (Digital Storefront & Bookings)
# ------------------------------------------------------------------------------
# Stripe (Global payments)
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay (India & international regional availability)
# Get keys at: https://dashboard.razorpay.com/app/keys
